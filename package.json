{
  "name": "@yasircs4/interactive-tutorial-video",
  "version": "1.1.0",
  "description": "Agent skill for interactive Full HD tutorial video recording with visual HUD overlays, localized neural voiceovers, and autonomous YouTube playlist management.",
  "type": "module",
  "main": "skills/interactive-tutorial-video/scripts/tutorial_engine.js",
  "exports": {
    ".": "./skills/interactive-tutorial-video/scripts/tutorial_engine.js",
    "./engine": "./skills/interactive-tutorial-video/scripts/tutorial_engine.js",
    "./convert": "./skills/interactive-tutorial-video/scripts/convert_video.js",
    "./shorts": "./skills/interactive-tutorial-video/scripts/build_shorts.js",
    "./uploader": "./skills/interactive-tutorial-video/scripts/youtube_session_uploader.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js && python3 -m unittest discover tests",
    "test:example": "node examples/full_tutorial_flow.js",
    "doctor": "node skills/interactive-tutorial-video/scripts/doctor.js",
    "quality-report": "python3 skills/interactive-tutorial-video/scripts/quality_report.py",
    "convert": "node skills/interactive-tutorial-video/scripts/convert_video.js",
    "build:shorts": "node skills/interactive-tutorial-video/scripts/build_shorts.js",
    "proofs": "node scripts/generate_proofs.js"
  },
  "keywords": [
    "agent-skill",
    "playwright",
    "video-automation",
    "edge-tts",
    "youtube-automation",
    "interactive-tutorials",
    "tutorial-engine",
    "screen-recording",
    "hud-overlays"
  ],
  "author": "Yasir Najeep <info@yasirnajeep.com> (https://yasirnajeep.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasircs4/interactive-tutorial-video.git"
  },
  "bugs": {
    "url": "https://github.com/yasircs4/interactive-tutorial-video/issues"
  },
  "homepage": "https://github.com/yasircs4/interactive-tutorial-video#readme",
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
